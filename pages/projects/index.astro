---
import LedgerPage from "../../src/components/LedgerPage.astro";
import ProjectRail from "../../src/components/ProjectRail.astro";
import SearchLauncher from "../../src/components/SearchLauncher.astro";
import { dateLabel, manifest } from "../../src/lib/journal";

const projects = [...manifest.projects].sort((a, b) =>
  (b.lastActivity ?? "").localeCompare(a.lastActivity ?? ""),
);
---

<LedgerPage title="Projects · Decision Ledger" route="/projects">
  <div class="ledger-shell">
    <ProjectRail projects={manifest.projects} />
    <main class="ledger-main inner-page">
      <header class="index-hero">
        <p class="eyebrow">Project index / {projects.length} territories</p>
        <h1>Every line of inquiry.</h1>
        <p>Session journals are primary. Commit journals remain available as supporting evidence.</p>
      </header>
      <SearchLauncher compact />
      <div class="project-index">
        {
          projects.map((project, index) => (
            <a href={`/projects/${project.name}`}>
              <span class="row-number">{String(index + 1).padStart(2, "0")}</span>
              <strong>{project.name}</strong>
              <span>{project.sessionCount} sessions</span>
              <span>{project.commitCount} commits</span>
              <time>{dateLabel(project.lastActivity)}</time>
            </a>
          ))
        }
      </div>
    </main>
  </div>
</LedgerPage>
